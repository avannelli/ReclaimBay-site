// ReclaimBay analytics schema.
// Behavioral events only: no report rows, customer data, amounts, or filenames.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Lifecycle rules (allowed transitions, entry requirements) live in
// src/prospectStatus.ts. do_not_contact is terminal: a compliance flag.
// The commercial outcome of outreach (meeting, proposal, customer, lost) is
// a prospect status; what happened to each message is an Outreach status.
enum ProspectStatus {
  new
  qualified
  ready_to_contact
  contacted
  engaged
  meeting
  proposal
  customer
  not_a_fit
  lost
  do_not_contact
  archived
}

// A signal row exists only when the value is known; no row means unknown.
enum SignalValue {
  yes
  no
}

// Who recorded a candidate signal or evidence item. Automated research only
// ever replaces its own entries; a person's entries are never touched.
enum RecordOrigin {
  manual
  research
}

enum ResearchStatus {
  queued
  running
  completed
  failed
}

// How far a researched fact is established.
//   verified    confirmed on the business's own (verified) website
//   unverified  reported by a provider or found but not confirmed
//   uncertain   sources disagree, or the evidence is too weak to decide
//   not_found   looked for and not found
enum FactState {
  verified
  unverified
  uncertain
  not_found
}

enum EventType {
  landing_view
  upload_started
  scan_completed
  tour_completed
  report_exported
  contact_clicked
}

enum ExportType {
  pdf
  csv
  copied_summary
}

// A prospective shop. Only public business information: never owner
// personal details, and never anything from a customer's report.
// Milestone 3: where a discovered business is in review. Only a human
// approval (-> approved) creates a Prospect; see src/discovery/candidateStatus.ts.
enum CandidateStatus {
  discovered
  researching
  researched
  needs_review
  approved
  rejected
  duplicate
}

enum DiscoveryRunStatus {
  queued
  running
  completed
  failed
}

// Provider-neutral discovery filter. Never a qualification verdict.
enum CategoryTier {
  core
  adjacent
}

// Category check: is this the kind of business the target serves?
// Not qualification, not a score, and not a candidate status.
enum CategoryVerdict {
  in_target
  wrong_category
  unclear
}

// A person's answer to a possible-duplicate flag. A confirmed duplicate is the
// candidate status `duplicate`; null means nobody has answered yet.
enum DuplicateDecision {
  not_duplicate
  unresolved
}

// Where a category verdict came from. "manual" is a person's decision,
// which the automated checks never overwrite.
enum CategorySource {
  provider
  name
  website
  manual
}

// A provider's own claim about whether a place operates. Unverified.
enum ProviderOperatingStatus {
  open
  temporarily_closed
  permanently_closed
}

enum ProviderImportStatus {
  running
  completed
  failed
}

// Outreach (see OUTREACH.md). Rules live in src/outreach/lifecycle.ts.
// What happened to one message: draft -> queued -> sent -> delivered ->
// replied, or bounced / failed / cancelled. Nothing in this version sends.
enum OutreachStatus {
  draft
  queued
  sent
  delivered
  bounced
  failed
  replied
  cancelled
}

enum OutreachKind {
  initial
  follow_up
}

// A person's reading of a reply.
enum ReplyOutcome {
  interested
  not_interested
  do_not_contact
  other
}

enum OutreachEventType {
  drafted
  queued
  sent
  delivered
  bounced
  failed
  replied
  cancelled
  // Not status changes: a spam complaint, and an unsubscribe by link.
  complained
  unsubscribed
}

// Why an address must never be emailed again.
enum SuppressionReason {
  bounced
  complained
  unsubscribed
  invalid
}

model Prospect {
  id           String  @id @default(uuid()) @db.Uuid
  referralCode String  @unique
  businessName String?
  website      String?

  city       String? @db.VarChar(100)
  state      String? @db.VarChar(50)
  postalCode String? @db.VarChar(20)
  country    String  @default("US") @db.Char(2)

  // Publicly listed business contact details, each with where it was found.
  phone          String? @db.VarChar(30)
  phoneSourceUrl String? @db.VarChar(500)
  email          String? @db.VarChar(254)
  emailSourceUrl String? @db.VarChar(500)

  // Cache of src/scoring.ts output, for sorting and filtering.
  score        Int       @default(0)
  scoreVersion String?   @db.VarChar(32)
  scoredAt     DateTime?

  status          ProspectStatus @default(new)
  statusChangedAt DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  candidate     DiscoveryCandidate?
  sessions      AnalyticsSession[]
  events        ProductEvent[]
  signals       ProspectSignal[]
  evidence      ProspectEvidence[]
  notes         ProspectNote[]
  statusChanges ProspectStatusChange[]
  outreach      Outreach[]
  invitations   Invitation[]

  @@index([status, score])
  @@index([score])
  @@index([state, city])
}

// One observed scoring input. Keys are defined in src/scoring.ts.
model ProspectSignal {
  id         String      @id @default(uuid()) @db.Uuid
  prospectId String      @db.Uuid
  key        String      @db.VarChar(64)
  value      SignalValue
  observedAt DateTime    @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([prospectId, key])
  @@index([key, value])
}

// A short public excerpt supporting one signal. Never a copied page.
model ProspectEvidence {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @db.Uuid
  signalKey  String   @db.VarChar(64)
  sourceUrl  String   @db.VarChar(500)
  excerpt    String   @db.VarChar(280)
  createdAt  DateTime @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, signalKey])
}

// Append-only admin notes.
model ProspectNote {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @db.Uuid
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
}

// Audit trail of every status change.
model ProspectStatusChange {
  id         String          @id @default(uuid()) @db.Uuid
  prospectId String          @db.Uuid
  fromStatus ProspectStatus?
  toStatus   ProspectStatus
  reason     String?         @db.VarChar(500)
  createdAt  DateTime        @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
}

model AnalyticsSession {
  id                 String   @id @default(uuid()) @db.Uuid
  anonymousSessionId String   @unique @db.Uuid
  prospectId         String?  @db.Uuid
  // The invitation this browser arrived through (first touch, like prospectId).
  invitationId       String?  @db.Uuid
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())

  prospect   Prospect?      @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  invitation Invitation?    @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  events     ProductEvent[]

  @@index([prospectId])
  @@index([invitationId])
  @@index([lastSeenAt])
}

model ProductEvent {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @db.Uuid
  prospectId String?     @db.Uuid
  eventType  EventType
  campaign   String?     @db.VarChar(64)
  exportType ExportType?
  isSample   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  session  AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  prospect Prospect?        @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([prospectId, eventType])
  @@index([eventType, isSample, createdAt])
}

// One execution of a discovery provider for a target area.
model DiscoveryRun {
  id              String             @id @default(uuid()) @db.Uuid
  provider        String             @db.VarChar(40)
  region          String             @db.VarChar(100)
  city            String?            @db.VarChar(100)
  businessType    String             @db.VarChar(100)
  // Category tiers this run selected (empty = provider default).
  tiers           CategoryTier[]
  // The provider release the run read, when the provider is versioned.
  providerRelease String?            @db.VarChar(64)
  // Staged import a background run read from, if any.
  importId        String?            @db.Uuid
  status          DiscoveryRunStatus @default(running)
  // Counters for the last finished run.
  found           Int                @default(0)
  created         Int                @default(0)
  duplicates      Int                @default(0)
  flagged         Int                @default(0)
  invalid         Int                @default(0)
  error           String?            @db.VarChar(300)
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  // Updated as a background run makes progress; a stale value means the
  // worker died and the run can be safely reclaimed.
  heartbeatAt     DateTime?
  finishedAt      DateTime?

  import     ProviderImport?      @relation(fields: [importId], references: [id], onDelete: SetNull)
  candidates DiscoveryCandidate[]

  @@index([createdAt])
  @@index([status, createdAt])
}

// A discovered business awaiting research and human review. Same public
// business facts as a Prospect, but kept out of the prospect pipeline until
// approved. Score and qualification are never stored here: they are computed
// from the signals by src/scoring.ts whenever needed.
model DiscoveryCandidate {
  id    String  @id @default(uuid()) @db.Uuid
  runId String? @db.Uuid

  // Identity
  businessName  String  @db.VarChar(120)
  website       String? @db.VarChar(200)
  // Business street address and position: used to tell a second location
  // of the same business from a duplicate record.
  streetAddress String? @db.VarChar(200)
  latitude      Float?
  longitude     Float?
  city          String? @db.VarChar(100)
  state         String? @db.VarChar(50)
  postalCode    String? @db.VarChar(20)
  country       String  @default("US") @db.Char(2)

  // Verified public business contact, each with where it was found. Only
  // a person or research sets these; a provider never does.
  phone          String? @db.VarChar(30)
  phoneSourceUrl String? @db.VarChar(500)
  email          String? @db.VarChar(254)
  emailSourceUrl String? @db.VarChar(500)

  // A phone the provider reported. Unverified: it never counts as public
  // contact, never satisfies Ready to contact, and is not copied on approval.
  providerPhone String? @db.VarChar(30)

  // Normalized match keys, written by src/discovery/normalize.ts.
  domainKey   String? @db.VarChar(200)
  nameKey     String  @db.VarChar(160)
  locationKey String? @db.VarChar(160)
  phoneKey    String? @db.VarChar(15)

  // Discovery provenance
  provider     String   @db.VarChar(40)
  externalId   String?  @db.VarChar(200)
  sourceUrl    String?  @db.VarChar(500)
  query        String?  @db.VarChar(300)
  discoveredAt DateTime @default(now())

  // Provider-reported data quality, kept as the provider stated it.
  providerRelease     String?                  @db.VarChar(64)
  providerCategory    String?                  @db.VarChar(100)
  categoryTier        CategoryTier?
  providerBrand       String?                  @db.VarChar(120)
  providerConfidence  Float?
  providerStatus      ProviderOperatingStatus?
  providerRetrievedAt DateTime?
  // Upstream datasets and licenses behind the provider record (attribution).
  providerSources     String?                  @db.VarChar(200)

  // Review
  status            CandidateStatus @default(discovered)
  statusChangedAt   DateTime        @default(now())
  researchedAt      DateTime?
  // Set when automated research confirmed the stored website is the
  // business's own; cleared whenever the website changes.
  websiteVerifiedAt DateTime?
  decisionReason    String?         @db.VarChar(500)
  decidedAt         DateTime?

  // Category check (src/discovery/categoryCheck.ts): the business's name,
  // then its own website, or a person. Never deletes or rejects anything; a
  // wrong-category candidate can't be approved and isn't ranked by score.
  // Null: not checked yet.
  categoryVerdict   CategoryVerdict?
  categoryReason    String?          @db.VarChar(300)
  categorySource    CategorySource?
  categorySourceUrl String?          @db.VarChar(500)
  // The rule set that decided, e.g. "automotive@c1" (null for a person).
  categoryRules     String?          @db.VarChar(40)
  categoryCheckedAt DateTime?

  // Possible (not confident) duplicates, flagged for a human. The flag is
  // kept after a decision, as the record of what the check found.
  possibleDuplicateCandidateId String? @db.Uuid
  possibleDuplicateProspectId  String? @db.Uuid
  duplicateReason              String? @db.VarChar(120)
  duplicateDecision            DuplicateDecision?
  duplicateDecidedAt           DateTime?
  // True while the candidate's Needs review hold is the one the duplicate
  // check placed. A person's own status change clears it, so answering the
  // duplicate question never lifts a hold a person set.
  duplicateHold                Boolean            @default(false)

  // Not a duplicate: another location sharing this business's website
  // (a multi-location business or chain). A research hint only.
  relatedCandidateId String? @db.Uuid
  relatedProspectId  String? @db.Uuid
  relationReason     String? @db.VarChar(120)

  // Set on approval; the candidate row stays as provenance.
  prospectId String?   @unique @db.Uuid
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run      DiscoveryRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  prospect Prospect?           @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  signals  CandidateSignal[]
  evidence CandidateEvidence[]
  notes    CandidateNote[]
  research CandidateResearch[]

  @@unique([provider, externalId])
  @@index([status, discoveredAt])
  @@index([domainKey])
  @@index([nameKey, locationKey])
  @@index([phoneKey])
  @@index([runId])
  @@index([categoryTier])
  @@index([categoryVerdict])
}

// One recorded observation. No row means unknown (same as ProspectSignal).
model CandidateSignal {
  id          String       @id @default(uuid()) @db.Uuid
  candidateId String       @db.Uuid
  key         String       @db.VarChar(64)
  value       SignalValue
  observedAt  DateTime     @default(now())
  origin      RecordOrigin @default(manual)

  candidate DiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, key])
}

// A short public excerpt supporting one signal. Never a copied page.
model CandidateEvidence {
  id          String       @id @default(uuid()) @db.Uuid
  candidateId String       @db.Uuid
  signalKey   String       @db.VarChar(64)
  sourceUrl   String       @db.VarChar(500)
  excerpt     String       @db.VarChar(280)
  createdAt   DateTime     @default(now())
  origin      RecordOrigin @default(manual)
  // The research run that recorded it (research origin only).
  researchId  String?      @db.Uuid

  candidate DiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  research  CandidateResearch? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  @@index([candidateId, signalKey])
}

// One automated research run for a candidate (see src/research). Runs are
// history: the newest completed run is the current picture, and only the
// most recent few are kept.
model CandidateResearch {
  id           String         @id @default(uuid()) @db.Uuid
  candidateId  String         @db.Uuid
  status       ResearchStatus @default(queued)
  // The researcher's rule version, e.g. "r1".
  version      String         @db.VarChar(20)
  // "admin", "batch", or "cli".
  trigger      String         @db.VarChar(20)
  // What the run concluded, e.g. "website_verified", "no_website".
  outcome      String?        @db.VarChar(40)
  pagesFetched Int            @default(0)
  // Short, readable warnings ("Provider phone not found on the website").
  warnings     Json?
  error        String?        @db.VarChar(300)
  queuedAt     DateTime       @default(now())
  startedAt    DateTime?
  heartbeatAt  DateTime?
  finishedAt   DateTime?

  candidate DiscoveryCandidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sources   ResearchSource[]
  facts     ResearchFact[]
  evidence  CandidateEvidence[]

  @@index([candidateId, queuedAt])
  @@index([status, queuedAt])
}

// A public URL a research run requested. Never the page body.
model ResearchSource {
  id          String   @id @default(uuid()) @db.Uuid
  researchId  String   @db.Uuid
  // "website" (a page of the business's site), "robots", or "https_check".
  kind        String   @db.VarChar(20)
  url         String   @db.VarChar(500)
  finalUrl    String?  @db.VarChar(500)
  fetchedAt   DateTime @default(now())
  httpStatus  Int?
  ok          Boolean
  contentType String?  @db.VarChar(100)
  bytes       Int?
  note        String?  @db.VarChar(200)

  research CandidateResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  facts    ResearchFact[]

  @@index([researchId])
}

// One researched fact: what was found, how established, and where.
model ResearchFact {
  id         String    @id @default(uuid()) @db.Uuid
  researchId String    @db.Uuid
  // e.g. "website", "business_name", "address", "phone", "email", "services".
  field      String    @db.VarChar(40)
  value      String?   @db.VarChar(500)
  state      FactState
  confidence Float?
  sourceId   String?   @db.Uuid
  // A short supporting quote (at most 280 characters), never a copied page.
  excerpt    String?   @db.VarChar(280)
  note       String?   @db.VarChar(300)

  research CandidateResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  source   ResearchSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([researchId])
}

model CandidateNote {
  id          String   @id @default(uuid()) @db.Uuid
  candidateId String   @db.Uuid
  body        String   @db.VarChar(2000)
  createdAt   DateTime @default(now())

  candidate DiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

// One import of a provider release into staging, for a geographic scope
// (e.g. US-CA). Runs outside the web process; see src/discovery/staging.ts.
model ProviderImport {
  id          String               @id @default(uuid()) @db.Uuid
  provider    String               @db.VarChar(40)
  release     String               @db.VarChar(64)
  // The import partition: "US-CA" for a state, "US-CA/ventura-county" for one county.
  scope       String               @db.VarChar(40)
  // Human-readable area, e.g. "Ventura County, CA".
  area        String?              @db.VarChar(100)
  status      ProviderImportStatus @default(running)
  recordCount Int                  @default(0)
  error       String?              @db.VarChar(300)
  // Importer counters (rows scanned, outside the area, not automotive, malformed...).
  stats       Json?
  startedAt   DateTime             @default(now())
  finishedAt  DateTime?

  places ProviderPlace[]
  runs   DiscoveryRun[]

  @@index([provider, scope, status, startedAt])
}

// A staged provider record: only the minimized business fields discovery
// needs. No raw payloads, emails, social handles, reviews, or people.
model ProviderPlace {
  id              String                   @id @default(uuid()) @db.Uuid
  importId        String                   @db.Uuid
  externalId      String                   @db.VarChar(200)
  businessName    String                   @db.VarChar(120)
  website         String?                  @db.VarChar(200)
  phone           String?                  @db.VarChar(30)
  streetAddress   String?                  @db.VarChar(200)
  city            String?                  @db.VarChar(100)
  county          String?                  @db.VarChar(100)
  state           String?                  @db.VarChar(50)
  postalCode      String?                  @db.VarChar(20)
  country         String?                  @db.Char(2)
  latitude        Float?
  longitude       Float?
  category        String?                  @db.VarChar(100)
  categoryTier    CategoryTier?
  brand           String?                  @db.VarChar(120)
  confidence      Float?
  operatingStatus ProviderOperatingStatus?
  sourceUrl       String?                  @db.VarChar(500)
  // Upstream datasets and licenses the provider assembled the record from, e.g. "meta (CDLA-Permissive-2.0)".
  sources         String?                  @db.VarChar(200)
  retrievedAt     DateTime                 @default(now())

  import ProviderImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, externalId])
  @@index([importId, state, county, city])
  @@index([importId, categoryTier])
}

// One outreach message to a prospect. Every attempt is its own row and is
// never overwritten: a follow-up or a retry is a new row. The generated
// message and the facts it relies on are frozen when it is drafted.
model Outreach {
  id           String       @id @default(uuid()) @db.Uuid
  prospectId   String       @db.Uuid
  kind         OutreachKind
  // The message this one follows up (follow_up only).
  followUpOfId String?      @db.Uuid

  template    String   @db.VarChar(40)
  // Added to the referral link, so visits and scans are attributed to it.
  campaign    String?  @db.VarChar(64)
  subject     String   @db.VarChar(200)
  body        String   @db.VarChar(5000)
  // The stored facts the message relies on, each with its source.
  evidence    Json
  generatedAt DateTime

  // The public business email, with where it was found.
  recipientEmail     String  @db.VarChar(254)
  recipientSourceUrl String  @db.VarChar(500)
  senderName         String? @db.VarChar(120)
  senderEmail        String? @db.VarChar(254)

  status            OutreachStatus @default(draft)
  statusChangedAt   DateTime       @default(now())
  // The prospect's id while the message is open (draft or queued), null
  // otherwise: at most one open message per prospect, enforced here.
  openForProspectId String?        @unique @db.Uuid

  queuedAt      DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  // When it bounced or failed, and why.
  failedAt      DateTime?
  failureReason String?       @db.VarChar(500)
  repliedAt     DateTime?
  replyOutcome  ReplyOutcome?
  replySummary  String?       @db.VarChar(2000)
  cancelledAt   DateTime?
  cancelReason  String?       @db.VarChar(500)

  // The prospect's opportunity score when the message was queued, and the
  // scoring model that computed it (src/scoring.ts SCORING_VERSION). Written
  // once, with queuedAt, and never updated, so rescoring the prospect can't
  // rewrite what this message was sent on. Null if never queued, or queued
  // before these were recorded.
  queuedScore        Int?
  queuedScoreVersion String? @db.VarChar(32)

  // Set by the sending provider. Never credentials.
  provider          String? @db.VarChar(40)
  providerMessageId String? @unique @db.VarChar(200)

  // Sending. sendStartedAt is set once, when a dispatcher claims the message;
  // a claimed message is only ever retried with the same idempotency key.
  sendStartedAt    DateTime?
  sendAttempts     Int       @default(0)
  lastSendError    String?   @db.VarChar(500)
  // Opaque token for the one-click unsubscribe link.
  unsubscribeToken String?   @unique @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospect   Prospect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  followUpOf Outreach?       @relation("FollowUp", fields: [followUpOfId], references: [id], onDelete: Restrict)
  followUps  Outreach[]      @relation("FollowUp")
  events     OutreachEvent[]
  invitation Invitation?

  @@index([prospectId, createdAt])
  @@index([status, statusChangedAt])
}

// Append-only log of what happened to each message: the raw data for
// outreach counts. Prospect outcomes are in ProspectStatusChange.
model OutreachEvent {
  id              String            @id @default(uuid()) @db.Uuid
  outreachId      String            @db.Uuid
  type            OutreachEventType
  detail          String?           @db.VarChar(500)
  // The provider's id for the notification that caused this event, so a
  // repeated webhook can never be recorded twice.
  providerEventId String?           @unique @db.VarChar(200)
  createdAt       DateTime          @default(now())

  outreach Outreach @relation(fields: [outreachId], references: [id], onDelete: Cascade)

  @@index([outreachId, createdAt])
  @@index([type, createdAt])
}

// Addresses that must never be emailed again, whatever prospect they are on.
// Only ever added to.
model EmailSuppression {
  id         String            @id @default(uuid()) @db.Uuid
  email      String            @unique @db.VarChar(254)
  reason     SuppressionReason
  detail     String?           @db.VarChar(500)
  outreachId String?           @db.Uuid
  createdAt  DateTime          @default(now())
}

// The global sending switch. Append-only: the newest row is the current
// state, and no row means sending is off.
model OutreachControlChange {
  id             String   @id @default(uuid()) @db.Uuid
  sendingEnabled Boolean
  reason         String   @db.VarChar(500)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// An invitation to try ReclaimBay, for one outreach contact attempt: its
// first message (a follow-up reuses it). Only a SHA-256 hash of the public
// token is stored; the token itself lives in the link alone. Opens are
// counted here; activation is measured from ProductEvent (a real scan in a
// session that arrived through the invitation). Never deleted: revoking
// keeps the history. Rules in src/invitations/.
model Invitation {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  prospectId    String    @db.Uuid
  outreachId    String    @unique @db.Uuid
  // The outreach message's campaign, frozen when the invitation is made.
  campaign      String?   @db.VarChar(64)
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  revokeReason  String?   @db.VarChar(200)
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  openCount     Int       @default(0)

  prospect Prospect           @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  outreach Outreach           @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  sessions AnalyticsSession[]

  @@index([prospectId])
  @@index([campaign])
}
