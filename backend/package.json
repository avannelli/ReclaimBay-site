{
  "name": "reclaimbay-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "prospect:create": "node --env-file-if-exists=.env dist/scripts/createProspect.js",
    "seed:dev": "node --env-file-if-exists=.env dist/scripts/seedDev.js",
    "prospects:rescore": "node --env-file-if-exists=.env dist/scripts/rescore.js",
    "test": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env --test --test-concurrency=1 test/integration/*.test.ts",
    "discovery:import": "node --env-file-if-exists=.env dist/scripts/importProvider.js",
    "discovery:process": "node --env-file-if-exists=.env dist/scripts/processDiscoveryRuns.js",
    "discovery:research": "node --env-file-if-exists=.env dist/scripts/researchCandidates.js",
    "discovery:check-categories": "node --env-file-if-exists=.env dist/scripts/checkCategories.js",
    "discovery:auto-approve": "node --env-file-if-exists=.env dist/scripts/autoApprove.js",
    "outreach:draft": "node --env-file-if-exists=.env dist/scripts/draftOutreach.js",
    "outreach:prepare": "node --env-file-if-exists=.env dist/scripts/prepareOutreach.js",
    "outreach:send": "node --env-file-if-exists=.env dist/scripts/sendOutreach.js",
    "outreach:inbox": "node --env-file-if-exists=.env dist/scripts/readOutreachInbox.js"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.5",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
