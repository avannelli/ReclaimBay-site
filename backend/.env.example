# Copy to backend/.env for local development. Never commit real values.

# Postgres connection string. On Railway, reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/reclaimbay

# Exact origin(s) allowed to send analytics, comma-separated, no trailing slash.
ALLOWED_ORIGIN=http://localhost:3000

# Admin password for /admin. At least 24 characters; /admin is disabled otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=

# One-time report purchases. Missing settings disable purchasing, not the preview.
# Use only TEST credentials locally. Never expose these through NEXT_PUBLIC_*.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create one one-time USD Price (launch amount 4900 cents) for the report Product.
# Change this Price ID for a later price; historical purchases retain their snapshots.
STRIPE_REPORT_PRICE_ID=
STRIPE_REPORT_PRODUCT_ID=

# Optional
# PORT=8080
# PUBLIC_SITE_URL=https://reclaimbay.com
# TRUST_PROXY_HOPS=1
# LOG_LEVEL=info

# AI shadow layer (see AI.md). Off unless all are set; shadow only, never acts.
# AI_SHADOW_ENABLED=1
# AI_SMOKE_ENABLED=1   # only while running npm run ai:smoke once
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_SHADOW_DAILY_BUDGET=1
# AI_SHADOW_BATCH_LIMIT=5
