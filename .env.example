# Copy to .env.local for local development. Public: inlined into the static build.

# Base URL of the analytics backend (backend/), no trailing slash.
# Leave unset to turn analytics off entirely.
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:8080

# Public payment API origin only; never a Stripe secret or webhook signing key.
NEXT_PUBLIC_BILLING_API_URL=http://localhost:8080
