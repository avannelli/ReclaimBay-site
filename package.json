{
  "name": "reclaimbay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:paid-report": "node scripts/buildPaidReport.mjs",
    "dev": "next dev",
    "build": "npm run build:paid-report && next build && npm run verify:public-build",
    "verify:public-build": "node scripts/verifyPublicBuild.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "test:purchase-browser": "node test/e2e/purchase.mjs",
    "dev:admin": "npm --prefix backend run dev:db -- migrate && npm --prefix backend run dev",
    "dev:admin:setup": "npm --prefix backend run dev:setup --",
    "dev:admin:reset": "npm --prefix backend run dev:db -- reset",
    "dev:admin:seed": "npm --prefix backend run dev:seed"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "next": "16.3.7",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@next/env": "16.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "fake-indexeddb": "6.2.6",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
